# Axiom 环境变量模板 / Axiom environment variable template
# 复制为 .env 后填入真实值；.env 已被 .gitignore 忽略，不会提交。
# Copy to .env and fill in real values; .env is gitignored and will not be committed.
# 注意：本项目默认本地 Embedding，无需任何外部 API Key 即可运行。

# === 大模型（可选）/ LLM (optional) ===
# LLM_PROVIDER: deepseek | qwen；不配置 API Key 时自动使用规则引擎降级
# No API key -> rule-based fallback automatically.
LLM_PROVIDER=deepseek

# DeepSeek / 深度求索
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-chat
DEEPSEEK_REASONER_MODEL=deepseek-reasoner
DEEPSEEK_TEMPERATURE=0.1
DEEPSEEK_MAX_TOKENS=4096

# 通义千问（阿里云百炼 OpenAI 兼容模式）/ Qwen via DashScope OpenAI-compatible mode
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_CHAT_MODEL=qwen-plus
QWEN_REASONER_MODEL=qwen-max
QWEN_TEMPERATURE=0.1
QWEN_MAX_TOKENS=4096

# === Embedding（默认本地，无需 Key）/ Embedding (local by default, no key needed) ===
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL_PATH=./data/models/bge-small-zh-v1.5/model.onnx
EMBEDDING_VOCAB_PATH=./data/models/bge-small-zh-v1.5/vocab.txt
EMBEDDING_THREADS=2
# 切换到远程 API 时才需要 / Only needed when provider=api
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=512

# === 构建加速（可选）/ Build acceleration (optional) ===
# Maven 依赖镜像，弱网/国内构建可设置 / Maven mirror for slow networks, e.g. https://maven.aliyun.com/repository/public
MAVEN_MIRROR=

# === 存储路径 / Storage paths ===
DATA_DIR=./data
METADATA_TYPE=h2
ZVEC_ENABLED=true
ZVEC_DIMENSION=512
ZVEC_PATH=./data/zvec/dataset_semantics
ZVEC_KNOWLEDGE_PATH=./data/zvec/knowledge_base_v2

# === Rerank 与上下文 / Rerank & context ===
RERANK_PROVIDER=auto
RERANK_ENABLED=true
RERANK_CANDIDATE_SIZE=20
KNOWLEDGE_CONTEXT_CHAR_BUDGET=2000

# === JDBC 数据源（可选）/ JDBC datasource (optional) ===
# 用 /api/datasources/jdbc 接口录入连接信息，连接密码加密存储于元数据库。
# Use POST /api/datasources/jdbc to register a connection; password is encrypted in metadata DB.

# === 数据库账号（内嵌库通常无需修改）/ Embedded DB credentials ===
DB_USER=sa
DB_PASSWORD=
