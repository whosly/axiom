# Axiom - Git 忽略清单 / Git ignore list

# === 构建产物 / Build artifacts ===
frontend/dist/
frontend/node_modules/
backend/target/
*.class
*.jar
!backend/src/main/resources/static/.gitkeep

# === 覆盖率报告（由 scripts/coverage.sh 生成）/ Coverage reports (generated by scripts/coverage.sh) ===
reports/coverage/

# TypeScript 构建产物 / TypeScript build artifacts
*.tsbuildinfo
frontend/vite.config.js
frontend/vite.config.d.ts

# === 前端构建产物（复制到后端的静态资源）/ Frontend build copied into backend ===
backend/src/main/resources/static/assets/
backend/src/main/resources/static/index.html

# === 运行时数据 / Runtime data (databases, vectors, models) ===
# 这些数据由应用运行时生成，不应提交 / Generated at runtime, must not be committed.
backend/data/
.git/
*.db
*.mv.db
*.duckdb
*.proxima

# === 本地大模型文件（90MB，按 LOCAL_DEPLOYMENT.md 首次下载）/ Local model files ===
*.onnx
*.onnx.data

# === 环境变量与密钥 / Environment & secrets ===
.env
.env.*
!.env.example
*.key
*.pem
# 运行时 LLM 配置（含厂商设置，可能含历史版本明文密钥）/ Runtime LLM config
**/llm-config.json

# === IDE 与系统文件 / IDE & OS files ===
.vscode/
.codebuddy/
.workbuddy/
.trae/
.claude/
.grok/
.mvn/
.idea/
.cloudbase/
*.iml
.DS_Store
Thumbs.db

# === 日志与运行时文件 / Logs & runtime files ===
*.log
*.pid
.deploy-mode
logs/

# === 浏览器测试临时文件 / Browser test artifacts ===
.playwright-cli/
# Playwright 生成的报告配置；不再通配 *.yaml，避免误忽略未来加入的 CI/部署 yaml。
# / Only Playwright's own generated yaml is ignored; a blanket *.yaml rule would
# silently skip future CI/deployment manifests.
.playwright/*.yaml

# vite 配置编译产物与临时文件 / vite config build artifacts
frontend/vite.config.js
frontend/vite.config.d.ts
frontend/vite.config.ts.timestamp-*.mjs
